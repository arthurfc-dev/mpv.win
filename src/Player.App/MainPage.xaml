<Page
    x:Class="Player.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Player.App.Views"
    Loaded="OnLoaded" SizeChanged="OnPageSizeChanged"
    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" KeyboardAcceleratorPlacementMode="Hidden">
  <Page.Resources>
    <Style x:Key="PlayerIconButton" TargetType="Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{ThemeResource PlayerChromeForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PlayerToggleButton" TargetType="ToggleButton">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{ThemeResource PlayerChromeForegroundBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAccelerator" />
  </Page.KeyboardAccelerators>
  <Grid x:Name="PlayerRoot" Background="Transparent">
    <!-- The surface fills the client area, including the transparent title bar.
         Controls never participate in its size calculation. -->
    <Grid x:Name="VideoArea" Background="Transparent" Visibility="Collapsed" />

    <views:HomeView x:Name="HomeShell" Margin="0,40,0,0" Visibility="Collapsed" />

    <Grid x:Name="StatusOverlay" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  MaxWidth="440" Margin="32,64,32,40" Spacing="18">
        <Border x:Name="EmptyIconWell" Width="88" Height="88" CornerRadius="24" Visibility="Collapsed"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center">
          <FontIcon x:Name="StatusIcon" Glyph="&#xE714;" FontSize="36"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Border>
        <ProgressRing x:Name="LoadingRing" IsActive="True" Width="40" Height="40" />
        <TextBlock x:Name="StatusTitle" Text="Preparing playback"
                   Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap"
                   TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="StatusDetail" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Button x:Name="EmptyOpenButton" HorizontalAlignment="Center"
                Style="{StaticResource AccentButtonStyle}" Padding="20,10"
                Click="OnOpen" IsEnabled="False" AutomationProperties.Name="Open video file"
                ToolTipService.ToolTip="Open file (Ctrl+O)">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE8E5;" FontSize="16" />
            <TextBlock Text="Open file" />
          </StackPanel>
        </Button>
        <TextBlock x:Name="OpenHint" Text="Ctrl+O to open a file" HorizontalAlignment="Center"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
      </StackPanel>
    </Grid>

    <views:StartupView x:Name="StartupScreen" />

    <Border x:Name="PlaybackControls" VerticalAlignment="Bottom" RequestedTheme="Dark"
            SizeChanged="OnPlaybackControlsSizeChanged"
            Background="{ThemeResource PlayerOverlayBrush}" Padding="24,32,24,18"
            Visibility="Collapsed" IsHitTestVisible="False"
            PointerEntered="OnControlsEntered" PointerExited="OnControlsExited"
            GotFocus="OnControlsFocusChanged" LostFocus="OnControlsFocusChanged">
      <StackPanel Spacing="8">
        <TextBlock x:Name="MediaTitle" Text="Video" FontSize="15" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" MaxLines="1"
                   Foreground="{ThemeResource PlayerChromeForegroundBrush}" />
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ElapsedLabel" Text="0:00" FontSize="12" VerticalAlignment="Center"
                     Foreground="{ThemeResource PlayerChromeForegroundBrush}" />
          <Slider x:Name="SeekBar" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False"
                  MinHeight="32" IsThumbToolTipEnabled="True"
                  AutomationProperties.Name="Playback position" ValueChanged="OnSeekChanged" />
          <TextBlock x:Name="DurationLabel" Grid.Column="2" Text="0:00" FontSize="12" VerticalAlignment="Center"
                     Foreground="{ThemeResource PlayerChromeForegroundBrush}" />
        </Grid>
        <Grid x:Name="TransportRow" MinHeight="56">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="TransportButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button x:Name="PreviousChapterButton" Style="{StaticResource PlayerIconButton}" Click="OnPreviousChapter"
                    IsEnabled="False" AutomationProperties.Name="Previous chapter" ToolTipService.ToolTip="Previous chapter">
              <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
              </Button.Resources>
              <FontIcon Glyph="&#xE892;" FontSize="20" />
            </Button>
            <Button x:Name="SeekBackButton" Style="{StaticResource PlayerIconButton}" Click="OnSeekBack"
                    AutomationProperties.Name="Seek backward 5 seconds" ToolTipService.ToolTip="Back 5 seconds (Left)">
              <FontIcon Glyph="&#xEB9E;" FontSize="20" />
            </Button>
            <Button x:Name="PlayButton" Width="56" Height="56" CornerRadius="28" Padding="14"
                    Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="OnPlay"
                    AutomationProperties.Name="Play" ToolTipService.ToolTip="Play (Space)">
              <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="24" />
            </Button>
            <Button x:Name="SeekForwardButton" Style="{StaticResource PlayerIconButton}" Click="OnSeekForward"
                    AutomationProperties.Name="Seek forward 5 seconds" ToolTipService.ToolTip="Forward 5 seconds (Right)">
              <FontIcon Glyph="&#xEB9D;" FontSize="20" />
            </Button>
            <Button x:Name="NextChapterButton" Style="{StaticResource PlayerIconButton}" Click="OnNextChapter"
                    IsEnabled="False" AutomationProperties.Name="Next chapter" ToolTipService.ToolTip="Next chapter">
              <Button.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
              </Button.Resources>
              <FontIcon Glyph="&#xE893;" FontSize="20" />
            </Button>
          </StackPanel>
          <StackPanel x:Name="AuxiliaryControls" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <ToggleButton x:Name="LoopButton" Style="{StaticResource PlayerToggleButton}" Click="OnLoop"
                          IsEnabled="False" AutomationProperties.Name="Loop video" ToolTipService.ToolTip="Loop video: Off">
              <ToggleButton.Resources>
                <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
              </ToggleButton.Resources>
              <FontIcon Glyph="&#xE8EE;" FontSize="18" />
            </ToggleButton>
            <Button x:Name="SubtitleButton" Style="{StaticResource PlayerIconButton}" IsEnabled="False"
                    AutomationProperties.Name="Subtitles" ToolTipService.ToolTip="Subtitles">
              <SymbolIcon Symbol="ClosedCaption" />
              <Button.Flyout>
                <MenuFlyout x:Name="SubtitleMenu" Opening="OnSubtitleMenuOpening"
                            Opened="OnFlyoutOpened" Closed="OnFlyoutClosed" Placement="Top" />
              </Button.Flyout>
            </Button>
            <Button x:Name="AudioButton" Style="{StaticResource PlayerIconButton}" IsEnabled="False"
                    AutomationProperties.Name="Audio tracks" ToolTipService.ToolTip="Audio tracks">
              <SymbolIcon Symbol="Audio" />
              <Button.Flyout>
                <MenuFlyout x:Name="AudioMenu" Opening="OnAudioMenuOpening"
                            Opened="OnFlyoutOpened" Closed="OnFlyoutClosed" Placement="Top" />
              </Button.Flyout>
            </Button>
            <Button x:Name="VolumeButton" Style="{StaticResource PlayerIconButton}"
                    AutomationProperties.Name="Volume" ToolTipService.ToolTip="Volume">
              <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="18" />
              <Button.Flyout>
                <Flyout x:Name="VolumeFlyout" Opened="OnVolumeFlyoutOpened" Closed="OnVolumeFlyoutClosed" Placement="Top">
                 <Flyout.FlyoutPresenterStyle>
                  <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                    <Setter Property="Padding" Value="8" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                 </Flyout.FlyoutPresenterStyle>
                 <StackPanel x:Name="VolumeFlyoutContent" Spacing="12"
                             PointerEntered="OnVolumeFeedbackInteraction" GotFocus="OnVolumeFeedbackFocus">
                  <Grid ColumnSpacing="8" MinHeight="32">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="VolumeFlyoutMuteButton" Style="{StaticResource PlayerIconButton}"
                            Width="32" Height="32" Padding="8"
                            Click="OnToggleMute" AutomationProperties.Name="Mute" ToolTipService.ToolTip="Mute">
                      <FontIcon x:Name="VolumeFlyoutIcon" Glyph="&#xE767;" FontSize="14" />
                    </Button>
                    <Slider x:Name="VolumeBar" Grid.Column="1" Width="128" Height="32" VerticalAlignment="Center"
                            Minimum="0" Maximum="100" Value="100" IsEnabled="False"
                            AutomationProperties.Name="Volume level" ValueChanged="OnVolumeChanged">
                      <Slider.Resources>
                        <!-- Center the native track and thumb in the compact speaker row. -->
                        <x:Double x:Key="SliderPreContentMargin">14</x:Double>
                        <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>
                        <x:Double x:Key="SliderPostContentMargin">14</x:Double>
                      </Slider.Resources>
                    </Slider>
                    <TextBlock x:Name="VolumeLabel" Grid.Column="2" Text="100" MinWidth="24" FontSize="12" VerticalAlignment="Center" />
                  </Grid>
                 </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="FullscreenButton" Style="{StaticResource PlayerIconButton}" Click="OnFullscreen"
                    AutomationProperties.Name="Enter fullscreen" ToolTipService.ToolTip="Fullscreen (F)">
              <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="18" />
            </Button>
            <Button Style="{StaticResource PlayerIconButton}" AutomationProperties.Name="More options"
                    ToolTipService.ToolTip="More options">
              <FontIcon Glyph="&#xE712;" FontSize="18" />
              <Button.Flyout>
                <MenuFlyout Opened="OnFlyoutOpened" Closed="OnFlyoutClosed" Placement="Top">
                  <MenuFlyoutItem x:Name="OpenButton" Text="Open file" IsEnabled="False" Click="OnOpen">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem x:Name="PreviousChapterMenuItem" Text="Previous chapter" IsEnabled="False" Click="OnPreviousChapter" />
                  <MenuFlyoutItem x:Name="NextChapterMenuItem" Text="Next chapter" IsEnabled="False" Click="OnNextChapter" />
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem x:Name="FullscreenMenuItem" Text="Enter fullscreen" Click="OnFullscreen">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE740;" /></MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Page>
