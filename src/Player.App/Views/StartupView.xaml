<UserControl
    x:Class="Player.App.Views.StartupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid AutomationProperties.Name="Loading mpv.win" AutomationProperties.LiveSetting="Polite">
    <Grid x:Name="ShadowReceiver" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" IsHitTestVisible="False" />
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border x:Name="IconWell" Grid.Row="0" Width="96" Height="96">
        <Image Source="ms-appx:///Assets/AppLogo.png" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
      </Border>
      <ProgressRing x:Name="LoadingIndicator" Grid.Row="1" Width="20" Height="20" Margin="0,24,0,0" IsActive="True"
                    AutomationProperties.Name="Preparing mpv.win" HorizontalAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
