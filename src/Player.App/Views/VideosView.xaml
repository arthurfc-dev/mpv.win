<UserControl
    x:Class="Player.App.Views.VideosView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Player.App.Views">
  <UserControl.Resources>
    <DataTemplate x:Key="VideoTemplate" x:DataType="views:VideoLibraryItem">
      <views:MediaCard Title="{x:Bind Title}" Thumbnail="{x:Bind Thumbnail, Mode=OneWay}"
                       FilePath="{x:Bind Path}" IsFolder="{x:Bind IsFolder}"
                       PlayRequested="OnCardPlay" MoreRequested="OnCardMore"
                       IsPreviewLoading="{x:Bind IsPreviewLoading, Mode=OneWay}"
                       DurationText="{x:Bind DurationText, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind FileName}"
                       AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" />
    </DataTemplate>
    <DataTemplate x:Key="SectionTemplate">
      <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              Margin="4,0,12,8" Visibility="{Binding HeaderVisibility}">
        <Grid ColumnSpacing="8" Padding="0,4,8,4" MinHeight="44">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <FontIcon Glyph="{Binding Glyph}" FontSize="20"/>
          <TextBlock Grid.Column="1" Text="{Binding Heading}" FontSize="20" MaxWidth="320" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
          <TextBlock Grid.Column="2" Text="{Binding FolderPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{Binding FolderPath}"/>
          <Button Grid.Column="3" Click="OnSectionToggle" Style="{StaticResource SubtleButtonStyle}"
                  Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                  AutomationProperties.Name="{Binding ToggleLabel}" ToolTipService.ToolTip="{Binding ToggleLabel}">
            <FontIcon Glyph="{Binding Chevron}" FontSize="12"/>
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <StackPanel Spacing="4" VerticalAlignment="Center">
        <TextBlock x:Name="FolderLabel" Text="Your Videos folder" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="CountLabel" Style="{ThemeResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    <GridView x:Name="VideosGrid" Grid.Row="1" Padding="0,0,20,0" ItemTemplate="{StaticResource VideoTemplate}"
              ItemContainerStyle="{StaticResource MediaCardContainerStyle}"
              SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnVideoClicked"
              ContainerContentChanging="OnContainerContentChanging" AutomationProperties.Name="Media gallery"
              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto">
      <GridView.ItemsPanel>
        <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="176" AreStickyGroupHeadersEnabled="False" /></ItemsPanelTemplate>
      </GridView.ItemsPanel>
      <GridView.GroupStyle>
        <GroupStyle HidesIfEmpty="False" HeaderTemplate="{StaticResource SectionTemplate}">
          <GroupStyle.HeaderContainerStyle>
            <Style TargetType="GridViewHeaderItem">
              <Setter Property="HorizontalAlignment" Value="Stretch" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="0" />
              <Setter Property="MinHeight" Value="0" />
              <!-- The default header adds its own divider and minimum height,
                   including when our header content is collapsed. -->
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="GridViewHeaderItem">
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </GroupStyle.HeaderContainerStyle>
        </GroupStyle>
      </GridView.GroupStyle>
    </GridView>
    <StackPanel x:Name="StatusPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                Spacing="12" MaxWidth="400" Margin="20">
      <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" Visibility="Collapsed" />
      <TextBlock x:Name="StatusTitle" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
      <TextBlock x:Name="StatusDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
